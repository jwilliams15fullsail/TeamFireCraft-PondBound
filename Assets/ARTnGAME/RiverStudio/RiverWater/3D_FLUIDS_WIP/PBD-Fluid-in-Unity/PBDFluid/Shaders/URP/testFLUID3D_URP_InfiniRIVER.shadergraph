{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2d3eedf19af14f5697ac0812755087f4",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GrabScreenPos (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -136.8000030517578,
            "y": 1252.0,
            "width": 244.80001831054688,
            "height": 277.5999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "6a31f625e38d4ab8843014bf1396cc81"
        },
        {
            "m_Id": "3b8bfc4c31894d30be0a67cbceead86c"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GrabScreenPos",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if UNITY_UV_STARTS_AT_TOP\r\n    float scale = -1.0;\r\n    #else\r\n    float scale = 1.0;\r\n    #endif\r\n    float4 o = pos* 0.5f;\r\n    o.xy = float2(o.x, o.y*scale) + o.w;\r\n#ifdef UNITY_SINGLE_PASS_STEREO\r\n    o.xy = TransformStereoScreenSpaceTex(o.xy, pos.w);\r\n#endif\r\n    o.zw = pos.zw;\nOut = o;"
}

