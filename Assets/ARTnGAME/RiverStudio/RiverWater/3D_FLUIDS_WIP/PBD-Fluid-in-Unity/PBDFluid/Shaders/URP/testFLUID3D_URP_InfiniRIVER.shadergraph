    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UnityObjectToClipPosA",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if defined(UNITY_SINGLE_PASS_STEREO) || defined(UNITY_USE_CONCATENATED_MATRICES)\r\n    Out = mul(UNITY_MATRIX_VP, mul(unity_ObjectToWorld, float4(pos, 1.0)));\r\n#else\r\n    Out = mul(UNITY_MATRIX_MVP, float4(pos, 1.0));\r\n#endif"
}

